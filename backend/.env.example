PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d
FRONTEND_URL=http://localhost:3000

# Gmail example: use a Gmail App Password, not your normal password.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM=your_sender_email@gmail.com

# Recommended for Render: use an HTTPS email provider instead of SMTP.
RESEND_API_KEY=re_your_resend_api_key